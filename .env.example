# Настройки магазина «ДЕТАЛЬ 24». Скопируйте этот файл в .env и заполните.
# Файл .env хранит пароли и в git не попадает.

# ===== База данных PostgreSQL =====
POSTGRES_DB=detal24
POSTGRES_USER=detal24
# Пароль базы данных. Придумайте длинный, от 16 символов, без пробелов.
# Если оставить пустым, скрипт scripts/first_run.sh подставит случайный.
POSTGRES_PASSWORD=

# ===== Сайт =====
# Порт, на котором сайт открывается на этом компьютере: http://localhost:HTTP_PORT
# На сервере оставьте 80.
HTTP_PORT=80
# Режим работы: prod на сервере, dev при разработке (в dev открыта документация API по адресу /api/docs)
APP_ENV=prod
# Подробность логов: INFO обычно, DEBUG при поиске проблем
LOG_LEVEL=INFO
# Секретный ключ для подписи входа в панель управления: любая случайная строка от 32 символов.
# Если оставить пустым, скрипт scripts/first_run.sh подставит случайный. Менять его не нужно.
SECRET_KEY=

# ===== Панель управления (адрес /admin) =====
# Первый владелец создаётся один раз при первом запуске, если сотрудников ещё нет.
# Логин латиницей, пароль не короче 8 символов. Потом пароль меняется командой из README.
ADMIN_LOGIN=owner
ADMIN_PASSWORD=
ADMIN_NAME=Владелец
# Сколько минут действует вход без активности до тихого обновления, и сколько дней живёт сессия
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# ===== Данные магазина =====
# Применяются один раз при первом запуске. Потом редактируются в панели управления.
SHOP_NAME=ДЕТАЛЬ 24
SHOP_SHORT_NAME=Д24
SHOP_CITY=Старобельск
# Телефон в формате +7 959 000-00-00 (показывается в шапке и подвале сайта)
SHOP_PHONE=
# Адрес пункта выдачи, например: г. Старобельск, ул. Ленина, 1
SHOP_ADDRESS=
SHOP_WORK_HOURS=Пн–Сб 9:00–18:00
# Реквизиты для подвала сайта: фамилия, имя и отчество ИП без слова «ИП» (например: Иванов Иван Иванович) и ИНН
SHOP_LEGAL_NAME=
SHOP_INN=
# Почта магазина для связи с покупателями
SHOP_EMAIL=
